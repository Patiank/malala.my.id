rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Izinkan baca & tulis permanen untuk seluruh koleksi operasional MALALA
    // (Destinasi, Budaya, Kuliner, Oleh-oleh, Event, Unduhan, Berita/Hot Info, Pengaturan, Booking)
    // Berlaku permanen tanpa batas kedaluwarsa 30 hari
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

