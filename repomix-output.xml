        <span class="font-semibold text-slate-700 font-orbitron">MINANGKAOS</span>
        <span class="font-orbitron font-bold text-gray-400">Hal. ${idx + 1} dari ${eventItems.length}</span>
      </div>
    </article>
    `;
  }).join('');

  return `
