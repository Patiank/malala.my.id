        driveCount++;
        console.log(`🔍 [${col.name}] Google Drive link: ${item.id} - ${item.title} -> Resolved: ${resolvedUrl}`);
      }
    }
  }

  console.log(`\nTotal checked: ${totalCount}`);
  console.log(`Empty URLs: ${emptyCount}`);
  console.log(`Google Drive URLs: ${driveCount}`);
}

checkAllImages();
