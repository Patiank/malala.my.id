        </div>

        ${ev.isKen ? `
          <div class="mt-2.5 p-2.5 bg-red-50 rounded-xl border border-red-200">
            <h4 class="font-bold text-[10px] uppercase text-red-900 tracking-wider mb-0.5 flex items-center gap-1">
