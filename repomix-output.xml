                <div className="flex gap-1 flex-wrap">
                  {categoryMap.map(cat => {
                    const count = allResults.filter(r => r.category.key === cat.key).length;
                    if (count === 0) return null;
                    return (
                      <span key={cat.key} className={`text-[9px] font-bold px-1.5 py-0.5 rounded-full ${cat.color}`}>
                        {cat.label}: {count}
